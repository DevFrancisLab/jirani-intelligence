# Optional backend-local overrides. Prefer the repository-root .env.
# Placeholders only. Never commit real credentials.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Zetaris UI proxy
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_ORG_SLUG=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_QUERY_LIMIT=25
ZETARIS_TIMEOUT_SECONDS=30
ZETARIS_SOURCES=

# Meterless Nightshift — put the exact GPT-OSS 20B (NVIDIA cloud) model id here.
# Do not silently substitute Llama or another provider.
METERLESS_ENABLED=false
METERLESS_BASE_URL=
METERLESS_API_KEY=
METERLESS_MODEL=
METERLESS_TIMEOUT_SECONDS=60
METERLESS_APP_ID=jirani-intelligence
METERLESS_RUNTIME_TOKEN=

SCOUT_SIGNING_KEY=
