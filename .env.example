# Copy to .env and fill in local values. Never commit .env.
# Placeholders only. Do not put real credentials in this file.

# Zetaris direct REST. The sign-in URL is not this value.
# REST_URL is the API base and must end in /api/v1.0.
# A local install uses http://localhost:8888/api/v1.0.
# A remote instance uses the API base supplied to you, not the organisation slug.
ZETARIS_REST_URL=
ZETARIS_ORG_ID=
ZETARIS_ORG_SLUG=
ZETARIS_API_KEY=
ZETARIS_BASE_URL=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_QUERY_LIMIT=25
ZETARIS_TIMEOUT_SECONDS=30

# Registered sources the agent may query. One entry per source.
# Format: qualified_name|what one row represents
# Separate entries with ;;
# Do not register NY_TAXI, TPCDS, or TPCH sample data as planning evidence.
ZETARIS_SOURCES=

# Meterless Nightshift is the AI provider. OpenAI-compatible local API.
# The runtime writes the bearer token to its proxy-token file.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
METERLESS_APP_ID=jirani-intelligence
METERLESS_TIMEOUT_SECONDS=60

# Local integrity key for Scout Intent execution contracts.
# Generate any long random string. This is not a sponsor credential.
SCOUT_SIGNING_KEY=
