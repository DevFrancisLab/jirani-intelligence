# Repository-root secrets file (canonical). Never commit .env.
# Placeholders only.

# Django (optional overrides; defaults work for local demo)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Zetaris UI proxy. BASE_URL is the web UI origin with no path.
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_ORG_SLUG=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_QUERY_LIMIT=25
ZETARIS_TIMEOUT_SECONDS=30
ZETARIS_SOURCES=

# Meterless Nightshift — exact GPT-OSS 20B (NVIDIA cloud) model id in METERLESS_MODEL.
# Do not substitute Llama or another provider. NVIDIA in a label is not proof of routing.
METERLESS_ENABLED=false
METERLESS_BASE_URL=
METERLESS_API_KEY=
METERLESS_MODEL=
METERLESS_TIMEOUT_SECONDS=60
METERLESS_APP_ID=jirani-intelligence
METERLESS_RUNTIME_TOKEN=

SCOUT_SIGNING_KEY=
